<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FITNESS TRACKER"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#14532D"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Daily Health Dashboard"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/tvTodaySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:text="TODAY'S PROGRESS&#10;&#10;Steps: 0&#10;Calories: 0 kcal&#10;Workout: 0 min"
            android:textSize="19sp"
            android:textColor="#14532D"/>

        <!-- DAILY FITNESS GOALS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_progress">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DAILY FITNESS GOALS"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#14532D"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Steps Goal (10,000)"
                android:layout_marginTop="15dp"/>

            <ProgressBar
                android:id="@+id/progressSteps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#16A34A"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calories Goal (500 kcal)"
                android:layout_marginTop="15dp"/>

            <ProgressBar
                android:id="@+id/progressCalories"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#16A34A"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workout Goal (60 min)"
                android:layout_marginTop="15dp"/>

            <ProgressBar
                android:id="@+id/progressWorkout"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#16A34A"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD ACTIVITY"
            android:textStyle="bold"
            android:textSize="21sp"
            android:textColor="#14532D"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/etType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Exercise type"
            android:inputType="text" />

        <EditText
            android:id="@+id/etMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Workout minutes"
            android:inputType="number" />

        <EditText
            android:id="@+id/etCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Calories burned"
            android:minHeight="48dp"
            android:inputType="number"/>

        <EditText
            android:id="@+id/etSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Steps"
            android:minHeight="48dp"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:padding="12dp"
            android:text="SAVE ACTIVITY"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            android:elevation="5dp" />

        <TextView
            android:id="@+id/tvWeeklySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:text="WEEKLY PROGRESS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#14532D"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECENT ACTIVITIES"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#14532D"
            android:layout_marginTop="25dp"/>

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:text="No activities recorded yet"
            android:textSize="16sp"
            android:textColor="#333333"/>

    </LinearLayout>
</ScrollView>